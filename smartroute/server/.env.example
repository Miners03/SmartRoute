PORT=8080
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# DB
DATABASE_URL=postgresql://smartroute:smartroute@localhost:5432/smartroute

# JWT
JWT_SECRET=change_me_in_env
JWT_EXPIRES_IN=8h

# Geocoding (Nominatim)
NOMINATIM_USER_AGENT=SmartRoute/1.0 (contact@example.com)
GEOCODE_TIMEOUT_MS=5000
GEOCODE_MAX_QPS=1
GEOCODE_RETRY_BACKOFF_MS=500

# Seed
SEED_MANAGER_EMAIL=manager@smartroute.test
SEED_MANAGER_PASSWORD=ManagerPass123!
SEED_MANAGER_NAME=Default Manager
SEED_RIDER_EMAIL=rider@smartroute.test
SEED_RIDER_PASSWORD=RiderPass123!
SEED_RIDER_NAME=Default Rider
SEED_RIDER_VEHICLE_TYPE=van
SEED_RIDER_MAX_STOPS=20

# Rate limit
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
